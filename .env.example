# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_NAME="aman_db"
DB_USER="postgres"
DB_PASSWORD="your_secure_password"
DB_HOST="localhost"
DB_PORT="5432"

# ==========================================
# Vector Database (Qdrant)
# ==========================================
QDRANT_HOST="localhost"
QDRANT_PORT="6333"

# ==========================================
# External API Keys
# ==========================================
# HuggingFace Token (optional, for downloading specific models)
HF_TOKEN="your_huggingface_token_here"

# Groq API Key (required for fast generative reasoning)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# ==========================================
# Django Backend Settings
# ==========================================
# Generate a new secure secret key before deploying to production!
SECRET_KEY="django-insecure-replace-with-your-secret-key-here"

# Set to False in production environments
DEBUG="True"

# Comma-separated list of allowed hostnames (e.g., "localhost,127.0.0.1")
ALLOWED_HOSTS="*"